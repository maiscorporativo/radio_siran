# Porta HTTP (na Hostinger normalmente é definida automaticamente)
PORT=3000

# Fuso horário usado em relatórios
TZ=America/Sao_Paulo

# Login do painel
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-uma-string-longa-e-aleatoria

# Banco de dados
# Notebook / local -> sqlite (arquivo em data/radio.db)
# Hostinger        -> mysql
DB_CLIENT=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Spotify (opcional) — Client ID do app criado em https://developer.spotify.com/dashboard
# Redirect URI a cadastrar no app:  <endereço do servidor>/player/callback.html
#   local: http://127.0.0.1:3000/player/callback.html   (o Spotify não aceita "localhost")
SPOTIFY_CLIENT_ID=

# Pasta onde os áudios enviados são salvos
UPLOAD_DIR=./uploads
# Tamanho máximo por arquivo (MB)
MAX_UPLOAD_MB=80
